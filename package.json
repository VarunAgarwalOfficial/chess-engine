{
  "name": "chess",
  "version": "2.0.0",
  "description": "A chess engine and a browser board to play against it.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/serve.js",
    "build:wasm": "scripts/build-wasm.sh",
    "uci": "cargo run --quiet --release --manifest-path engine/Cargo.toml --bin uci",
    "perft": "cargo run --quiet --release --manifest-path engine/Cargo.toml --bin uci -- perft",
    "perft:suite": "cargo build --quiet --release --manifest-path engine/Cargo.toml --bin uci --bin perft && engine/target/release/perft engine/target/release/uci",
    "test": "cargo test --manifest-path engine/Cargo.toml && node --test \"test/*.test.js\"",
    "test:deep": "cargo test --manifest-path engine/Cargo.toml --test perft -- --ignored",
    "lint": "cargo clippy --manifest-path engine/Cargo.toml --all-targets -- -D warnings && eslint .",
    "format": "cargo fmt --manifest-path engine/Cargo.toml && prettier --write .",
    "format:check": "cargo fmt --manifest-path engine/Cargo.toml --check && prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
